  "corrections": [
    "Test-only Option<PaintBudget> setup fixed; failed compilations retained.",
    "Old example initializes all five inline longhands before requiring shorthand serialization; prior pixels and hits unchanged.",
    "Final tile translation omits out-of-range images rather than changing repetition phase through clamping.",
    "New CSSOM expected identifier spelling corrected to existing lowercase serialization.",
    "Normalized background longhands retain their first complete validation and skip duplicate unchanged expansion/validation, recovering the original click within unchanged work limit.",
    "One incorrect native-vulkan CLI feature invocation is retained separately from compilation or test results."
  ],
  "limitations": [
    "Single gradient layer; no URL images, space/round, author origin/clip/attachment or logical positions.",
    "Native interpolation stays on CPU; eligibility remains opaque square corners outside opacity scopes.",
    "References are self-authored, not WPT conformance evidence.",
    "No new GPU execution, acquired-window or timing claim; all-standards compatibility, production security and Chromium performance target remain unmet."
  ],
