+fn partition_ledger() -> Ledger {
+    Ledger {
+        operations: 1,
+        sources: 0,
+        masks: 0,
+        rows: 0,
+        row_tables: 0,
+        coverage: 0,
+        image_bytes: 0,
+        image_lut_words: 0,
+        targets: 0,
+        cpu_pixels: 1025,
+        cpu_limit: 1_000_000,
+        gpu_upper: 0,
+        rounded_loop_work: 0,
+    }
+}
