      "commands": [
        {"op":"push_opacity","value":0.5},
        {"op":"rect","rect":[0,0,3,1],"rgba":[255,0,0,255]},
        {"op":"push_opacity","value":0.5},
        {"op":"rect","rect":[1,0,1,1],"rgba":[0,0,255,255]},
