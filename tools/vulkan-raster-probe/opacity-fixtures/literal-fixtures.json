{
  "format": 1,
  "status": "authored source-only expectations before implementation; no rendering execution",
  "pixel_encoding": "row-major packed RGB hexadecimal strings; alpha output remains opaque",
  "coordinate_rules": "Rect arrays are x,y,width,height. Document offset is added to ordinary shapes. PushFixed restores caller clip and fixed offset until PopFixed. A mask has absolute row origins and y, as in the existing core Glyph input. All radii are zero unless stated.",
  "cases": [
    {
      "name": "halfway-red-65-over-black",
      "frame": {"width": 3, "height": 1, "clear": "000000", "caller_clip": [0,0,3,1], "document_offset": [0,0], "fixed_offset": [0,0]},
      "commands": [
        {"op":"push_opacity","value":0.5},
        {"op":"rect","rect":[0,0,1,1],"rgba":[65,0,0,255]},
        {"op":"pop_opacity"}
      ],
      "native_expectation": "admit_in_certified_domain",
      "expected_pixels": ["210000","000000","000000"]
    },
    {
      "name": "opaque-backed-overlap-and-after-pop",
      "frame": {"width": 8, "height": 2, "clear": "ffffff", "caller_clip": [0,0,8,2], "document_offset": [0,0], "fixed_offset": [0,0]},
      "commands": [
        {"op":"push_opacity","value":0.5},
        {"op":"rect","rect":[0,0,6,2],"rgba":[255,0,0,255]},
        {"op":"rect","rect":[2,0,4,2],"rgba":[0,0,255,255]},
        {"op":"pop_opacity"},
        {"op":"rect","rect":[7,0,1,2],"rgba":[0,255,0,255]}
      ],
      "native_expectation": "admit_in_certified_domain",
      "expected_pixels": ["ff8080","ff8080","8080ff","8080ff","8080ff","8080ff","ffffff","00ff00","ff8080","ff8080","8080ff","8080ff","8080ff","8080ff","ffffff","00ff00"]
    },
    {
